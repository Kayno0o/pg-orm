{
  "name": "@kaynooo/pg-orm",
  "type": "module",
  "version": "1.0.10",
  "description": "Lightweight ORM for Bun SQL with PostgreSQL support",
  "author": "Kaynooo <https://git.kaynooo.fr/kaynooo>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/pg-orm"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/pg-orm/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "keywords": [
    "orm",
    "bun",
    "postgresql",
    "sql",
    "database"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf ./dist && bun build ./src/index.ts --outdir ./dist --target bun --sourcemap=external --production && tsc --project tsconfig.build.json",
    "dev": "bun --watch ./src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "rm -rf coverage coverage-report && bun test && genhtml -o coverage -c ./assets/gcov.css ./coverage/lcov.info >/dev/null",
    "doc": "typedoc ./src/**/*.ts --plugin typedoc-github-theme --hostedBaseUrl https://pages.kaynooo.fr/kaynooo/pg-orm/docs/ --useHostedBaseUrlForAbsoluteLinks",
    "check": "tsc --noEmit --strict",
    "lint:fix": "bunx --bun eslint . --fix --cache",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "migrate:create": "bun examples/cli-migrations.ts create",
    "migrate:run": "bun examples/cli-migrations.ts run",
    "migrate:rollback": "bun examples/cli-migrations.ts rollback",
    "migrate:reset": "bun examples/cli-migrations.ts reset",
    "migrate:status": "bun examples/cli-migrations.ts status",
    "migrate:generate": "bun examples/cli-migrations.ts generate",
    "circular": "madge --circular ./src/index.ts",
    "circular:schema": "madge ./src/index.ts --image graph.png",
    "duplicates": "jscpd ./src",
    "unused": "knip",
    "prepare": "husky"
  },
  "peerDependencies": {
    "bun-types": "latest"
  },
  "dependencies": {
    "@kaynooo/utils": "^1.7.2",
    "husky": "^9.1.7"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^1.5.3",
    "@types/benchmark": "^2.1.5",
    "@types/bun": "^1.3.3",
    "benchmark": "^2.1.4",
    "bun-types": "^1.3.3",
    "knip": "^5.70.2",
    "typedoc": "^0.28.14",
    "typedoc-github-theme": "^0.3.1"
  }
}
