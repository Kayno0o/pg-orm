{
  "name": "@kaynooo/pg-orm",
  "type": "module",
  "version": "3.0.3",
  "description": "Lightweight ORM for Bun SQL with PostgreSQL support",
  "author": "Kaynooo <https://git.kaynooo.fr/kaynooo>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/pg-orm"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/pg-orm/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "keywords": [
    "orm",
    "bun",
    "postgresql",
    "sql",
    "database"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf ./dist && bun build ./src/index.ts --outdir ./dist --target bun --sourcemap=external --production && tsc --project tsconfig.build.json",
    "dev": "bun --watch ./src/index.ts",
    "test:coverage": "rm -rf coverage coverage-report && bun test && genhtml -o coverage -c ./assets/gcov.css ./coverage/lcov.info >/dev/null",
    "doc": "typedoc ./src/**/*.ts --plugin typedoc-github-theme --hostedBaseUrl https://pages.kaynooo.fr/kaynooo/pg-orm/docs/ --useHostedBaseUrlForAbsoluteLinks",
    "check": "tsc --noEmit --strict",
    "lint:fix": "eslint . --fix --cache",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "circular": "madge --circular ./src/index.ts",
    "circular:schema": "madge ./src/index.ts --image graph.png",
    "duplicates": "jscpd ./src --threshold 2 --min-lines 10",
    "unused": "knip",
    "bench": "bash bench.sh",
    "prepare": "husky"
  },
  "peerDependencies": {
    "bun-types": "latest"
  },
  "dependencies": {
    "@kaynooo/utils": "^1.7.4"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^1.5.6",
    "@types/bun": "^1.3.8",
    "baseline-browser-mapping": "^2.9.19",
    "bun-types": "^1.3.8",
    "husky": "^9.1.7",
    "knip": "^5.83.0",
    "typedoc": "^0.28.16",
    "typedoc-github-theme": "^0.3.1"
  }
}
