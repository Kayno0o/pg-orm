{
  "name": "@kaynooo/pg-orm",
  "type": "module",
  "version": "1.0.9",
  "description": "Lightweight ORM for Bun SQL with PostgreSQL support",
  "author": "Kaynooo <https://git.kaynooo.fr/kaynooo>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/pg-orm"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/pg-orm/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "keywords": [
    "orm",
    "bun",
    "postgresql",
    "sql",
    "database"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf ./dist && bun build ./src/index.ts --outdir ./dist --target bun --sourcemap=external --production && tsc --project tsconfig.build.json",
    "dev": "bun --watch ./src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "tsc --noEmit --strict",
    "lint:fix": "bunx eslint . --fix",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d"
  },
  "peerDependencies": {
    "bun-types": "latest"
  },
  "dependencies": {
    "@kaynooo/eslint": "^1.4.0",
    "@kaynooo/utils": "^1.6.7"
  },
  "devDependencies": {
    "@types/benchmark": "^2.1.5",
    "@types/bun": "^1.3.1",
    "benchmark": "^2.1.4",
    "bun-types": "latest"
  }
}
