{
  "name": "@kaynooo/pg-orm",
  "type": "module",
  "version": "8.1.0",
  "description": "Lightweight ORM for Bun SQL with PostgreSQL support",
  "author": "Kaynooo <https://git.kaynooo.fr/kaynooo>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/pg-orm"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/pg-orm/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "keywords": [
    "orm",
    "bun",
    "postgresql",
    "sql",
    "database"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pg-orm": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "dist",
    "llms-full.txt",
    "llms.txt"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "rm -rf ./dist && bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target bun --production && tsc --project tsconfig.build.json",
    "dev": "bun --watch ./src/index.ts",
    "test:coverage": "rm -rf coverage coverage-report && bun test && genhtml -o coverage -c ./assets/gcov.css ./coverage/lcov.info >/dev/null",
    "doc": "typedoc ./src/**/*.ts --out ./typedoc --plugin typedoc-github-theme --hostedBaseUrl https://pages.kaynooo.fr/kaynooo/pg-orm/docs/ --useHostedBaseUrlForAbsoluteLinks",
    "check": "tsc --noEmit --strict",
    "llms": "bun scripts/llms.ts",
    "lint:fix": "keslint . --fix --cache",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "circular": "madge --circular --warning ./src/index.ts",
    "duplicates": "jscpd ./src --threshold 2 --min-lines 10",
    "bench": "bash bench.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@kaynooo/changelogitea": "^1.9.1",
    "@kaynooo/eslint": "^7.1.4",
    "@kaynooo/utils": "^2.30.1",
    "@types/bun": "^1.4.4",
    "baseline-browser-mapping": "^2.11.34",
    "bun-types": "^1.4.4",
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "^6.0.3"
  }
}
