#!/bin/sh
set -e

BUN_PATH=bun

if [ -f ~/.bun/bin/bun ]; then
  BUN_PATH=~/.bun/bin/bun
elif [ -f /usr/local/bin/bun ]; then
  BUN_PATH=/usr/local/bin/bun
fi

STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.ts$' | tr '\n' ' ')

if [ -z "$STAGED_TS_FILES" ]; then
  exit 0
fi

$BUN_PATH eslint --cache $STAGED_TS_FILES
$BUN_PATH run duplicates
$BUN_PATH run build
$BUN_PATH run check
